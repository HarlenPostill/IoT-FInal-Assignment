# Generated with: python3 tools/configure_cloud.py --local
LAB_GROUP_ID=YOUR_UNIQUE_GROUP_ID
# Host tools use localhost; Compose overrides this with http://influxdb:8086.
INFLUX_URL=http://localhost:8086
INFLUX_ORG=iot-local
INFLUX_BUCKET=environment_lab
# Local development only: the setup token is used for both writes and queries.
INFLUX_TOKEN=GENERATE_A_RANDOM_TOKEN
INFLUX_READ_TOKEN=THE_SAME_RANDOM_TOKEN
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=GENERATE_A_RANDOM_PASSWORD
GRAFANA_ADMIN_PASSWORD=GENERATE_A_RANDOM_PASSWORD
